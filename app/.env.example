# Copie este arquivo para ".env" (na pasta app/) e ajuste a URL da API.
# O arquivo .env NAO vai para o git, entao o git pull nunca mais da conflito aqui.
#
# iPhone (Expo Go): use o IP da sua maquina na Wi-Fi.
# Emulador Android: use http://10.0.2.2:5443
EXPO_PUBLIC_API_URL=http://192.168.0.10:5443
