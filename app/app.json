{
  "expo": {
    "name": "SGA Connect",
    "slug": "sga-connect",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "sgaconnect",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0E0E10",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "br.com.canainfo.sgaconnect"
    },
    "android": {
      "package": "br.com.canainfo.sgaconnect"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "_comentario": "apiUrl: no iPhone (Expo Go) use o IP da sua maquina na Wi-Fi, ex. http://192.168.0.10:5443. No emulador Android use http://10.0.2.2:5443.",
      "apiUrl": "http://10.0.2.2:5443"
    }
  }
}
