{
  "expo": {
    "name": "SGA Connect",
    "slug": "sga-connect",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "sgaconnect",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#ECECEF",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "br.com.canainfo.sgaconnect"
    },
    "android": {
      "package": "br.com.canainfo.sgaconnect"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-status-bar",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "_comentario": "NAO edite o apiUrl aqui para por seu IP — use um arquivo .env (EXPO_PUBLIC_API_URL), que nao vai pro git e evita conflito no pull. Veja app/.env.example. Este valor e so o fallback do emulador Android.",
      "apiUrl": "http://10.0.2.2:5443"
    }
  }
}
